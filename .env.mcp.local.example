# Copy to .env.mcp.local, fill in the values, and run: chmod 600 .env.mcp.local
# Or store it elsewhere and pass: ./scripts/querygap-mcp-local --env-file ~/.config/querygap/mcp.env
QG_MCP_DATABASE_URL=replace-with-dedicated-read-only-postgres-url
QG_MCP_EXPECTED_DB_ROLE=querygap_mcp_ro
QG_MCP_EMBEDDINGS_ENABLED=1
# Enable only after the same catalog database contains the allowlisted aou schema.
QG_MCP_AOU_ENABLED=0
OPENAI_API_KEY=replace-me

# Optional bounded settings
QG_MCP_DB_POOL_MIN=1
QG_MCP_DB_POOL_MAX=4
QG_MCP_DB_CONNECT_TIMEOUT_SECONDS=5
QG_MCP_DB_STATEMENT_TIMEOUT_MS=10000
QG_MCP_DB_LOCK_TIMEOUT_MS=1000
