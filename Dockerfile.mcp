FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 querygap \
    && useradd --system --uid 10001 --gid querygap \
        --home-dir /nonexistent --shell /usr/sbin/nologin querygap \
    && install -d -o querygap -g querygap /data

COPY requirements-mcp.txt ./
RUN python -m pip install --no-cache-dir --requirement requirements-mcp.txt

COPY --chown=querygap:querygap querygap_mcp ./querygap_mcp

EXPOSE 8000

# Railway mounts /data at runtime. Fix only that dedicated mount's ownership,
# then permanently drop privileges before starting the public server.
CMD ["sh", "-c", "chown querygap:querygap /data && exec gosu querygap:querygap python -m querygap_mcp.hosted"]
